<Application x:Class="GoalWidget.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="GoalInk" Color="#192B46" />
        <SolidColorBrush x:Key="GoalFrost" Color="#EDF0F4" />
        <SolidColorBrush x:Key="GoalRim" Color="#BFFFFFFF" />
        <SolidColorBrush x:Key="GoalInnerRim" Color="#24FFFFFF" />
        <LinearGradientBrush x:Key="GoalWarmLight" StartPoint="0,0.55" EndPoint="1,0.25">
            <GradientStop Color="#38FFDFBA" Offset="0" />
            <GradientStop Color="#00FFDFBA" Offset="0.72" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GoalSurfaceLight" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#66FFFFFF" Offset="0" />
            <GradientStop Color="#00FFFFFF" Offset="0.28" />
            <GradientStop Color="#00C6D8FF" Offset="0.66" />
            <GradientStop Color="#30C6D8FF" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="LandscapeFrost" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FCEEF0F5" Offset="0" />
            <GradientStop Color="#EBEDF0F4" Offset="0.29" />
            <GradientStop Color="#C9E9EFF5" Offset="0.50" />
            <!-- Keep a pale veil across the full text area, including five-line goals. -->
            <GradientStop Color="#B8E8EEF3" Offset="0.72" />
            <GradientStop Color="#B8E8EEF3" Offset="0.90" />
            <GradientStop Color="#70D8E4F3" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="GoalTypography" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Georgia" />
            <Setter Property="FontSize" Value="27.3" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="LineHeight" Value="28.392" />
            <Setter Property="Foreground" Value="{StaticResource GoalInk}" />
        </Style>

        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource GoalInk}" />
            <Setter Property="BorderBrush" Value="#C5CBD6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="Opacity" Value="0.76" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Face" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryDialogButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Background" Value="{StaticResource GoalInk}" />
            <Setter Property="BorderBrush" Value="{StaticResource GoalInk}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Application.Resources>
</Application>
