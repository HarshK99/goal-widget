<Window x:Class="GoalWidget.EditGoalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit goal" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="#F7F8FA"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
    <StackPanel Margin="28,24,28,24">
        <TextBlock Text="Your one thing." FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource GoalInk}" />
        <TextBlock Text="Keep it short. Enter starts a new line." Margin="0,6,0,16" Foreground="#5B6676" />
        <TextBox x:Name="Draft" AcceptsReturn="True" TextWrapping="Wrap" TextAlignment="Center"
                 FontFamily="Georgia" FontSize="23" Padding="12" Height="170"
                 Foreground="{StaticResource GoalInk}" BorderBrush="#C5CBD6"
                 VerticalScrollBarVisibility="Auto" TextChanged="Draft_Changed"
                 AutomationProperties.Name="Goal"
                 AutomationProperties.HelpText="Up to 100 characters and five lines. Escape cancels." />
        <TextBlock x:Name="Count" Margin="0,8,0,0" FontSize="12" Foreground="#5B6676" />
        <TextBlock x:Name="Error" Margin="0,10,0,0" Visibility="Collapsed" TextWrapping="Wrap"
                   Foreground="#B3261E" AutomationProperties.LiveSetting="Assertive" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="Cancel" Content="Cancel" IsCancel="True" Click="Cancel_Click"
                    Style="{StaticResource DialogButton}" />
            <Button x:Name="Save" Content="Save" Click="Save_Click"
                    Style="{StaticResource PrimaryDialogButton}" />
        </StackPanel>
    </StackPanel>
</Window>
