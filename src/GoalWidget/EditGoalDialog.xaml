<Window x:Class="GoalWidget.EditGoalDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Edit goal">
    <Grid x:Name="Host" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Loaded="Host_Loaded">
        <ContentDialog x:Name="Editor" Title="Your one thing." PrimaryButtonText="Save" CloseButtonText="Cancel"
                       DefaultButton="None" PrimaryButtonClick="Editor_Save" Closing="Editor_Closing">
            <ContentDialog.PrimaryButtonStyle>
                <Style TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                    <Setter Property="MinHeight" Value="44" />
                </Style>
            </ContentDialog.PrimaryButtonStyle>
            <ContentDialog.CloseButtonStyle>
                <Style TargetType="Button">
                    <Setter Property="MinHeight" Value="44" />
                </Style>
            </ContentDialog.CloseButtonStyle>
            <StackPanel Spacing="12">
                <TextBlock Text="Keep it short. Enter starts a new line." TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBox x:Name="Draft" Header="Goal" AcceptsReturn="True" TextWrapping="Wrap"
                         FontFamily="Georgia" FontSize="23" Padding="12" CornerRadius="8"
                         MinHeight="130" MaxHeight="210" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         AutomationProperties.HelpText="Up to 100 characters and five lines. Escape cancels."
                         TextChanged="Draft_Changed" />
                <TextBlock x:Name="Count" TextWrapping="Wrap" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="SaveStatus" Visibility="Collapsed" Text="Saving your goal…"
                           TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <TextBlock x:Name="Error" Visibility="Collapsed" TextWrapping="Wrap"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                           AutomationProperties.LiveSetting="Assertive" />
            </StackPanel>
        </ContentDialog>
    </Grid>
</Window>
