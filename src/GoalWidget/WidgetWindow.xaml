<Window x:Class="GoalWidget.WidgetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Goal">
    <Grid x:Name="Root" Background="Transparent" RequestedTheme="Light">
        <Grid x:Name="Artwork" IsHitTestVisible="False" Background="{StaticResource GoalGlassBase}">
            <Image Source="ms-appx:///Assets/landscape.png" Stretch="UniformToFill" Opacity="0.83"
                   AutomationProperties.AccessibilityView="Raw" />
            <Rectangle Fill="{StaticResource LandscapeFrost}" />
            <Rectangle Fill="{StaticResource GoalWarmLight}" />
            <Rectangle Fill="{StaticResource GoalSurfaceLight}" />
            <Border BorderThickness="1" BorderBrush="{StaticResource GoalRim}" />
            <Border Margin="3" BorderThickness="1" BorderBrush="{StaticResource GoalInnerRim}" CornerRadius="4" />
        </Grid>
        <Button x:Name="Card" Background="Transparent" BorderThickness="0"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                UseSystemFocusVisuals="True"
                FocusVisualMargin="6" FocusVisualPrimaryThickness="2" FocusVisualSecondaryThickness="1"
                AutomationProperties.Name="Your goal"
                AutomationProperties.HelpText="Press Enter to edit. Right-click or press Shift F10 for Edit goal and Quit. Press Alt and an arrow key to move."
                RightTapped="Card_RightTapped" KeyDown="Card_KeyDown">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid Background="{TemplateBinding Background}">
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                </ControlTemplate>
            </Button.Template>
            <TextBlock x:Name="Goal" Style="{StaticResource GoalTypography}" />
        </Button>
        <InfoBar x:Name="Notice" VerticalAlignment="Bottom" Margin="8" IsOpen="False"
                 Severity="Warning" IsClosable="True" AutomationProperties.LiveSetting="Polite" />
    </Grid>
</Window>
